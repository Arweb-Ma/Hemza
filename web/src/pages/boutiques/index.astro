---
import Breadcrumb from '@/components/Breadcrumb.astro';
import DealListing from '@/components/DealListing.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getDealFeed } from '@/lib/data';
import { filterDeals } from '@/lib/deals';
import { breadcrumbJsonLd } from '@/lib/seo';

const { deals: allDeals, generatedAt } = await getDealFeed();
const deals = filterDeals(allDeals, { tier: 'boutique' });
const crumbs = [{ label: 'Accueil', href: '/' }, { label: 'Boutiques' }];
---

<BaseLayout
  title="Promos des boutiques marocaines"
  description="Les promos des petites boutiques de mode marocaines en ligne, avec l'historique des prix et les fausses promos filtrées."
  structuredData={[breadcrumbJsonLd(crumbs, Astro.site, Astro.url.pathname)]}
>
  <div class="container page">
    <Breadcrumb items={crumbs} />
    <h1 class="display">Promos des boutiques</h1>
    <p class="lead">
      Les petites boutiques de mode marocaines en ligne. Beaucoup affichent une partie de leur
      catalogue en promo en permanence : cochez « Baisses vérifiées uniquement » pour ne garder que
      les prix qui ont vraiment baissé.
    </p>
    <DealListing deals={deals} updatedAt={generatedAt} heading="Promos des boutiques" />
  </div>
</BaseLayout>

<style>
  .page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    padding-top: var(--space-5);
  }
  h1 {
    font-size: var(--text-xl);
  }
  .lead {
    max-width: 60ch;
    color: var(--color-muted);
  }
</style>
