---
export interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav class="breadcrumb" aria-label="Fil d'Ariane">
  <ol>
    {items.map(({ label, href }) => (
      <li>{href ? <a href={href}>{label}</a> : <span aria-current="page">{label}</span>}</li>
    ))}
  </ol>
</nav>

<style>
  ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  li + li::before {
    content: '/';
    margin-right: var(--space-2);
  }
</style>
