---
import { SECTIONS, SECTION_LABEL, SITE } from '@/config/site';

const { pathname } = Astro.url;
const links = [
  { href: '/', label: 'Tout', current: pathname === '/' },
  ...SECTIONS.map((section) => ({
    href: `/${section}/`,
    label: SECTION_LABEL[section],
    current: pathname.startsWith(`/${section}/`),
  })),
];
---

<header class="site-header">
  <div class="container bar">
    <a class="logo" href="/" aria-label={`${SITE.name}, accueil`}>
      hemza<span>.</span>ma <small>{SITE.tagline}</small>
    </a>
    <nav aria-label="Rayons">
      <ul class="nav">
        {links.map(({ href, label, current }) => (
          <li>
            <a href={href} aria-current={current ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    {SITE.telegramUrl && (
      <a class="button button--positive telegram" href={SITE.telegramUrl} rel="noopener">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M21.9 4.3 18.8 19c-.2 1-.8 1.3-1.7.8l-4.6-3.4-2.2 2.1c-.3.3-.5.5-1 .5l.3-4.7 8.6-7.8c.4-.3-.1-.5-.6-.2L6.9 13 2.3 11.6c-1-.3-1-1 .2-1.5L20.6 3c.8-.3 1.6.2 1.3 1.3z" />
        </svg>
        Alertes Telegram
      </a>
    )}
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--color-line);
    background: rgb(251 246 239 / 0.92);
    backdrop-filter: blur(10px);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-3);
  }
  .logo {
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    text-decoration: none;
  }
  .logo span {
    color: var(--color-accent);
  }
  .logo small {
    margin-left: var(--space-1);
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--color-muted);
  }
  .nav {
    display: flex;
    gap: var(--space-2);
    margin: 0;
  }
  .nav a {
    display: block;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    background: var(--color-surface);
  }
  .nav a:hover {
    border-color: var(--color-ink);
  }
  .nav a[aria-current='page'] {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: #fff;
  }
  .telegram {
    margin-left: auto;
    min-height: 2.5rem;
    font-size: 0.875rem;
  }

  @media (max-width: 38.75em) {
    .logo small {
      display: none;
    }
    nav {
      order: 3;
      flex-basis: 100%;
      overflow-x: auto;
      scrollbar-width: none;
    }
  }
</style>
