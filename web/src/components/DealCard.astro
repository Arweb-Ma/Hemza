---
import GarmentArt from './GarmentArt.astro';
import Sparkline from './Sparkline.astro';
import { scoreLevel } from '@/lib/deals';
import { formatMad } from '@/lib/format';
import type { Deal } from '@/lib/types';

interface Props {
  deal: Deal;
  /** Load the image eagerly: set for the first row, which is visible without scrolling. */
  priority?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { deal, priority = false, headingLevel: Heading = 'h3' } = Astro.props;
const searchText = `${deal.title} ${deal.storeName}`.toLowerCase();
---

<article
  class="card"
  data-deal
  data-price={deal.price}
  data-saved={deal.savedMad}
  data-score={deal.score}
  data-discount={deal.discountPct}
  data-observed={deal.observedAt}
  data-lowest={deal.lowest90d ? '' : undefined}
  data-search={searchText}
>
  {deal.imageUrl ? (
    <img
      src={deal.imageUrl}
      alt=""
      width="400"
      height="500"
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
      referrerpolicy="no-referrer"
    />
  ) : (
    <GarmentArt category={deal.category} seed={deal.id} />
  )}
  <header>
    <p class="store">{deal.storeName}</p>
    <Heading class="title">
      <a class="card-link" href={`/promo/${deal.id}/`}>
        {deal.title}
      </a>
    </Heading>
  </header>
  <div class="details">
    <Sparkline values={deal.history} label="Évolution du prix sur 30 jours" />
    <p class="badges">
      {deal.lowest90d && <span class="badge badge--gold">Plus bas 90 j</span>}
      <span class="badge">Baisse vérifiée</span>
    </p>
    <p class="prices">
      <s>
        <span class="visually-hidden">Prix habituel : </span>
        {formatMad(deal.refPrice)}
      </s>
      <span aria-hidden="true">→</span>
      <strong>
        <span class="visually-hidden">Prix actuel : </span>
        {formatMad(deal.price)}
      </strong>
    </p>
    <p class="saving">Vous économisez {formatMad(deal.savedMad)}</p>
  </div>
  <p class="discount">
    <span class="visually-hidden">Remise : </span>-{deal.discountPct}%
  </p>
  <p class="score" data-level={scoreLevel(deal.score)} title="Score Hemza sur 100">
    <span class="visually-hidden">Score Hemza : </span>
    {deal.score}
  </p>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    transition: transform 0.15s ease;
  }
  .card:hover {
    transform: translateY(-3px);
  }
  .card:focus-within {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Media is the first child (photo or placeholder illustration). */
  .card > :is(img, svg):first-child {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: var(--color-line);
  }

  header {
    padding: var(--space-3) var(--space-3) 0;
  }
  .store {
    font-size: 0.71875rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .title {
    margin-top: var(--space-1);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  /* The title link is the card's single destination: stretch it over the whole card. */
  .card-link {
    text-decoration: none;
    outline: none;
  }
  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .details {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
    padding: var(--space-2) var(--space-3) var(--space-3);
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3125rem;
  }
  .prices {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.375rem;
    margin-top: auto;
  }
  .prices s,
  .prices span {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .prices strong {
    font-size: 1.125rem;
  }
  .saving {
    font-size: 0.78125rem;
    font-weight: 600;
    color: var(--color-accent-strong);
  }

  .discount,
  .score {
    position: absolute;
    top: 0.625rem;
    padding: 0.3125rem 0.5625rem;
    border-radius: 0.5625rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .discount {
    left: 0.625rem;
    font-size: 0.875rem;
    background: var(--color-accent);
    color: #fff;
  }
  .score {
    right: 0.625rem;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.71875rem;
    background: rgb(255 255 255 / 0.92);
  }
  .score::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .score[data-level='medium']::before {
    background: var(--color-gold);
  }
  .score[data-level='high']::before {
    background: var(--color-positive);
  }

  @media (max-width: 38.75em) {
    header {
      padding: var(--space-2) var(--space-2) 0;
    }
    .details {
      padding: var(--space-2);
    }
    .prices strong {
      font-size: 1rem;
    }
  }
</style>
